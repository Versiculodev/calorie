{
  "expo": {
    "name": "Calorie",
    "slug": "calorie",
    "description": "Log meals and see how many calories are left today.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calorie",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E6E7E2",
    "primaryColor": "#2F5E50",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.calorie.log",
      "supportsTablet": true
    },
    "android": {
      "package": "app.calorie.log",
      "adaptiveIcon": {
        "backgroundColor": "#E6E7E2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6E7E2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
